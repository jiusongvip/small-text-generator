---
import "@fontsource-variable/outfit/index.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";

export interface Props {
  title: string;
  description: string;
  date?: string;
  keywords?: string;
  canonicalUrl?: string;
}

const {
  title,
  description,
  date = new Date().toISOString().split("T")[0],
  keywords = "small text, unicode text, tiny text",
  canonicalUrl,
} = Astro.props;

const formattedDate = new Date(date + "T00:00:00").toLocaleDateString("en-US", {
  year: "numeric", month: "short", day: "numeric",
});
const readTime = Math.max(1, Math.ceil(description.split(/\s+/).length / 200));
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JZ37E49EB3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JZ37E49EB3');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | SmallTextGen Blog</title>
    <meta name="description" content={description} /><meta name="robots" content="index, follow" />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    <meta property="og:title" content={`${title} | SmallTextGen`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={date} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | SmallTextGen`} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#059669" />
    <meta property="og:image" content="https://www.small-text-gen.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content="https://www.small-text-gen.com/og-image.png" />
<script type="application/ld+json">
      {"@context":"https://schema.org","@type":"BlogPosting","headline":{JSON.stringify(title)},"description":{JSON.stringify(description)},"datePublished":{JSON.stringify(date)},"author":{"@type":"Organization","name":"SmallTextGen"}}
    </script>
  </head>
  <body class="min-h-[100dvh] font-sans bg-zinc-50 text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100">
    <header class="sticky top-0 z-50 border-b border-zinc-200/80 bg-zinc-50/90 backdrop-blur-md dark:border-zinc-800/80 dark:bg-zinc-950/90">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-3">
        <a href="/" class="flex items-center gap-2.5 font-semibold text-lg tracking-tight text-zinc-900 dark:text-zinc-100 hover:opacity-80 transition-opacity">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent-600 text-white text-sm font-bold shadow-sm shadow-accent-600/20">s</span>
          <span>SmallTextGen</span>
        </a>
        <nav class="flex items-center gap-5 text-sm font-medium text-zinc-500 dark:text-zinc-400">
          <a href="/blog/" class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors">Blog</a>
          <a href="/" class="inline-flex items-center gap-1 rounded-lg bg-accent-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-accent-700 transition-colors">Open Tool &rarr;</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-4 pt-10 pb-20 sm:pt-14">
      <a href="/blog/" class="inline-flex items-center gap-1.5 text-sm text-zinc-400 hover:text-accent-600 dark:text-zinc-500 dark:hover:text-accent-400 transition-colors mb-8 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-0.5 transition-transform"><path d="m15 18-6-6 6-6"/></svg>
        All Guides
      </a>

      <article class="blog-article">
        <header class="mb-10 sm:mb-12">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class="inline-flex items-center gap-1 rounded-full bg-accent-100 px-2.5 py-0.5 text-xs font-semibold text-accent-700 dark:bg-accent-900/40 dark:text-accent-300">Guide</span>
            <time datetime={date} class="text-sm text-zinc-400 dark:text-zinc-500">{formattedDate}</time>
            <span class="text-zinc-300 dark:text-zinc-600">&middot;</span>
            <span class="text-sm text-zinc-400 dark:text-zinc-500">{readTime} min read</span>
          </div>
          <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 sm:text-4xl sm:leading-tight">{title}</h1>
          <p class="mt-4 text-base leading-relaxed text-zinc-500 dark:text-zinc-400 max-w-2xl">{description}</p>
        </header>

        <div class="blog-content">
          <slot />
        </div>
      </article>

      <div class="mt-10 rounded-xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
        <div class="flex items-center gap-4">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-accent-600 text-lg font-bold text-white">S</div>
          <div>
            <div class="text-sm font-semibold text-zinc-800 dark:text-zinc-200">SmallTextGen Team</div>
            <div class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed mt-0.5">Every guide is based on firsthand testing across platforms — Discord, Steam, Valorant, and more. We test on actual devices (iOS, Android, Windows, macOS) before publishing.</div>
          </div>
        </div>
      </div>
      <div class="mt-16 rounded-2xl border border-accent-200 bg-gradient-to-br from-accent-50 to-accent-100/50 p-8 text-center dark:border-accent-900/40 dark:from-accent-950/40 dark:to-accent-950/20 sm:p-10">
        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-accent-600 text-xl text-white shadow-sm shadow-accent-600/20">⚡</div>
        <h2 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100 mb-2">Ready to try it?</h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-6 max-w-sm mx-auto">Type your text and get 9 small text styles instantly. Free, no ads, no sign-up.</p>
        <a href="/" class="inline-flex items-center gap-2 rounded-xl bg-accent-600 px-6 py-3 text-sm font-semibold text-white shadow-sm shadow-accent-600/25 hover:bg-accent-700 hover:shadow-md hover:shadow-accent-600/30 transition-all active:scale-[0.97]">
          Open Small Text Generator
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>

      <div class="mt-14 border-t border-zinc-200 pt-12 dark:border-zinc-800">
        <h2 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100 mb-5">More guides</h2>
        <div class="grid gap-4 sm:grid-cols-3">
          <a href="/blog/small-text-for-social-media/" class="group rounded-xl border border-zinc-200 bg-white p-5 hover:border-accent-300 hover:shadow-sm hover:-translate-y-0.5 transition-all duration-200 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-accent-600">
            <div class="mb-2 text-xl">📱</div>
            <div class="text-sm font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">Social Media Guide</div>
            <div class="text-xs text-zinc-400 dark:text-zinc-500 mt-1.5 leading-relaxed">Instagram, TikTok &amp; Twitter/X — char limits, style picks, bio examples</div>
          </a>
          <a href="/blog/small-text-for-discord/" class="group rounded-xl border border-zinc-200 bg-white p-5 hover:border-accent-300 hover:shadow-sm hover:-translate-y-0.5 transition-all duration-200 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-accent-600">
            <div class="mb-2 text-xl">💬</div>
            <div class="text-sm font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">Discord Guide</div>
            <div class="text-xs text-zinc-400 dark:text-zinc-500 mt-1.5 leading-relaxed">Messages, nicknames, status — tested on desktop &amp; mobile</div>
          </a>
          <a href="/blog/small-text-for-gaming/" class="group rounded-xl border border-zinc-200 bg-white p-5 hover:border-accent-300 hover:shadow-sm hover:-translate-y-0.5 transition-all duration-200 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-accent-600">
            <div class="mb-2 text-xl">🎮</div>
            <div class="text-sm font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">Gaming Guide</div>
            <div class="text-xs text-zinc-400 dark:text-zinc-500 mt-1.5 leading-relaxed">Compatibility for Valorant, Fortnite, Steam, LoL &amp; more</div>
          </a>
        </div>
      </div>
    </main>

    <footer class="border-t border-zinc-200 bg-white py-8 dark:border-zinc-800 dark:bg-zinc-900/50">
      <div class="mx-auto flex max-w-4xl flex-col items-center gap-4 px-4 text-center sm:flex-row sm:justify-between">
        <p class="text-xs text-zinc-400 dark:text-zinc-500">&copy; 2026 SmallTextGen. Free online tool. No ads, no sign-up.</p>
        <nav class="flex gap-6 text-xs text-zinc-400 dark:text-zinc-500">
          <a href="/privacy/" class="hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors">Privacy</a>
          <a href="/about/" class="hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors">About</a>
          <a href="/" class="hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors">Home</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* ===== Article Body Typography ===== */
  .blog-article .blog-content {
    font-size: 1rem;
    line-height: 1.75;
    color: rgb(82 82 91);
  }
  .dark .blog-content {
    color: rgb(161 161 170);
  }

  /* Lead paragraph */
  .blog-content > p:first-of-type {
    font-size: 1.125rem;
    line-height: 1.8;
    color: rgb(63 63 70);
  }
  .dark .blog-content > p:first-of-type {
    color: rgb(212 212 216);
  }

  /* ---- H2 Section Headings ---- */
  .blog-content h2 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: rgb(24 24 27);
    margin-top: 3rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgb(228 228 231);
    scroll-margin-top: 5rem;
  }
  .dark .blog-content h2 {
    color: rgb(244 244 245);
    border-bottom-color: rgb(39 39 42);
  }

  /* ---- H3 Sub-headings ---- */
  .blog-content h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: rgb(39 39 42);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    scroll-margin-top: 5rem;
  }
  .dark .blog-content h3 {
    color: rgb(228 228 231);
  }

  /* ---- Paragraphs ---- */
  .blog-content p {
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
  }

  /* ---- Strong text ---- */
  .blog-content strong {
    color: rgb(24 24 27);
    font-weight: 600;
  }
  .dark .blog-content strong {
    color: rgb(244 244 245);
  }

  /* ---- Links ---- */
  .blog-content a {
    color: rgb(22 163 74);
    font-weight: 500;
    text-decoration: none;
  }
  .blog-content a:hover {
    text-decoration: underline;
  }
  .dark .blog-content a {
    color: rgb(74 222 128);
  }

  /* ===== TABLES ===== */
  .blog-content table {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    border-radius: 0.875rem;
    overflow: hidden;
    border: 1px solid rgb(228 228 231);
    background: white;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.06), 0 1px 2px rgb(0 0 0 / 0.04);
  }
  .dark .blog-content table {
    border-color: rgb(39 39 42);
    background: rgb(24 24 27 / 0.4);
  }

  .blog-content thead th {
    background: rgb(248 250 252);
    color: rgb(51 65 85);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 2px solid rgb(226 232 240);
    border-left: 2px solid transparent;
  }
  .blog-content thead th:first-child {
    border-left: 3px solid rgb(22 163 74);
    padding-left: calc(1rem - 1px);
  }
  .dark .blog-content thead th {
    background: rgb(15 23 42);
    color: rgb(203 213 225);
    border-bottom-color: rgb(51 65 85);
  }
  .dark .blog-content thead th:first-child {
    border-left-color: rgb(74 222 128);
  }

  .blog-content tbody td {
    padding: 0.625rem 1rem;
    vertical-align: middle;
    border-bottom: 1px solid rgb(241 245 249);
    background: white;
  }
  .dark .blog-content tbody td {
    border-bottom-color: rgb(30 41 59);
    background: transparent;
  }

  .blog-content tbody tr:last-child td {
    border-bottom: none;
  }

  .blog-content tbody tr:nth-child(even) td {
    background: rgb(248 250 252);
  }
  .dark .blog-content tbody tr:nth-child(even) td {
    background: rgb(15 23 42 / 0.5);
  }

  .blog-content tbody tr:hover td {
    background: rgb(240 253 244);
  }
  .dark .blog-content tbody tr:hover td {
    background: rgb(22 163 74 / 0.08);
  }

  /* ---- Lists ---- */
  .blog-content ul,
  .blog-content ol {
    padding-left: 1.5rem;
    margin: 0.75rem 0;
  }
  .blog-content li {
    margin-top: 0.375rem;
    margin-bottom: 0.375rem;
  }
  .blog-content ul > li::marker {
    color: rgb(161 161 170);
    font-size: 0.85em;
  }
  .dark .blog-content ul > li::marker {
    color: rgb(113 113 122);
  }
  .blog-content ol > li::marker {
    color: rgb(113 113 122);
    font-weight: 500;
    font-size: 0.875em;
  }
  .dark .blog-content ol > li::marker {
    color: rgb(161 161 170);
  }

  /* ---- Mobile Tables ---- */
  @media (max-width: 640px) {
    .blog-content {
      font-size: 0.9375rem;
    }
    .blog-content > p:first-of-type {
      font-size: 1.0625rem;
    }
    .blog-content h2 {
      font-size: 1.25rem;
      margin-top: 2.25rem;
    }
    .blog-content h3 {
      font-size: 1.05rem;
      margin-top: 1.5rem;
    }
    .blog-content table {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      white-space: nowrap;
      border-radius: 0.5rem;
      font-size: 0.8125rem;
    }
    .blog-content thead th,
    .blog-content tbody td {
      white-space: nowrap;
      padding: 0.5rem 0.75rem;
    }
  }
</style>

<style is:global>
  @import "../styles/global.css";
</style>
