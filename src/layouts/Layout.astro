---
import "@fontsource-variable/outfit/index.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import outfitLatinUrl from "@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2";

export interface Props {
  ogImage?: string;
  title?: string;
  description?: string;
  canonicalUrl?: string;
}
const { ogImage, title, description, canonicalUrl } = Astro.props;
const defaultOgImage = ogImage || "/og-image.png";
const ogImageUrl = `https://www.small-text-gen.com${defaultOgImage}`;
const ogUrl = canonicalUrl || `https://www.small-text-gen.com${Astro.url.pathname}`;
---
<!doctype html>
<html lang="en">
  <head>
    <link rel="preload" as="font" type="font/woff2" href={outfitLatinUrl} crossorigin />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JZ37E49EB3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JZ37E49EB3');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    {title ? <title>{title}</title> : null}
    {description ? <meta name="description" content={description} /> : null}
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    <meta name="theme-color" content="#059669" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {title ? <meta property="og:title" content={title} /> : null}
    {description ? <meta property="og:description" content={description} /> : null}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="SmallTextGen" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {title ? <meta name="twitter:title" content={title} /> : null}
    {description ? <meta name="twitter:description" content={description} /> : null}
    <meta name="twitter:image" content={ogImageUrl} />
    <slot name="extra-head" />
  </head>
  <body class="min-h-[100dvh] font-sans">
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>