  <header class="sticky top-0 z-50 border-b border-zinc-200/80 bg-zinc-50/90 backdrop-blur-md dark:border-zinc-800/80 dark:bg-zinc-950/90">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3"><a href="/" class="flex items-center gap-2.5 font-semibold text-lg tracking-tight text-zinc-900 dark:text-zinc-100"><span class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent-600 text-white text-sm font-bold">s</span><span class="hidden sm:inline">SmallTextGen</span></a><nav class="flex items-center gap-4 text-sm font-medium text-zinc-500 dark:text-zinc-400"><a href="/" class="hover:text-accent-600 dark:hover:text-accent-400">Main Tool</a><a href="/superscript-text/" class="hover:text-accent-600 dark:hover:text-accent-400">Superscript</a><a href="/subscript-text/" class="hover:text-accent-600 dark:hover:text-accent-400">Subscript</a></nav></div>
  </header>

  <main class="mx-auto max-w-3xl px-4 pt-12 pb-16">
    <div class="mb-2 inline-flex items-center gap-1.5 rounded-full bg-accent-100 px-3 py-1 text-xs font-semibold text-accent-700 dark:bg-accent-900/40 dark:text-accent-300">Unique Feature — No Other Tool Does This</div>
    <h1 class="mb-4 text-4xl font-bold tracking-tighter text-zinc-900 dark:text-zinc-100">Tiny Numbers Generator</h1>
    <p class="mb-8 text-base leading-relaxed text-zinc-500 dark:text-zinc-400">Convert digits 0-9 and math symbols into superscript or subscript format. A feature no other small text generator offers. Perfect for dates, IDs, equations, and chemical formulas.</p>

    <div class="grid gap-4 sm:grid-cols-2 mb-0">
      <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-900"><div class="mb-3 text-xs font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">Superscript Numbers</div><textarea id="input-sup" rows="1" placeholder="e.g. 2026" class="w-full resize-none rounded-lg border border-zinc-300 bg-white px-3 py-2 text-base font-medium text-zinc-900 placeholder:text-zinc-400 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/20 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:placeholder:text-zinc-500"></textarea><div id="output-sup" class="mt-2 min-h-[1.8em] break-all rounded-lg bg-zinc-50 px-3 py-2 text-2xl font-medium text-zinc-800 dark:bg-zinc-800/50 dark:text-zinc-200" style="font-family:system-ui">²⁰²⁶</div><button id="copy-sup" class="mt-2 flex items-center gap-1 rounded-lg border border-zinc-200 bg-white px-2.5 py-1.5 text-xs font-medium text-zinc-500 hover:border-accent-300 hover:text-accent-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400">Copy</button></div>
      <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-900"><div class="mb-3 text-xs font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">Subscript Numbers</div><textarea id="input-sub" rows="1" placeholder="e.g. H2O" class="w-full resize-none rounded-lg border border-zinc-300 bg-white px-3 py-2 text-base font-medium text-zinc-900 placeholder:text-zinc-400 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/20 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:placeholder:text-zinc-500"></textarea><div id="output-sub" class="mt-2 min-h-[1.8em] break-all rounded-lg bg-zinc-50 px-3 py-2 text-2xl font-medium text-zinc-800 dark:bg-zinc-800/50 dark:text-zinc-200" style="font-family:system-ui">H₂O</div><button id="copy-sub" class="mt-2 flex items-center gap-1 rounded-lg border border-zinc-200 bg-white px-2.5 py-1.5 text-xs font-medium text-zinc-500 hover:border-accent-300 hover:text-accent-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400">Copy</button></div>
    </div>

    <div class="mt-14 space-y-10">
      <div><h2 class="mb-3 text-xl font-semibold text-zinc-900 dark:text-zinc-100">What Are Tiny Numbers?</h2><div class="space-y-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400"><p>Tiny numbers are regular digits (0-9) converted into their <strong>Unicode superscript or subscript equivalents</strong>. Unlike most small text generators that only convert letters, we handle digits and math symbols too. This means you can convert an entire message — letters AND numbers — into a cohesive style.</p><p><strong>Why we built this:</strong> We noticed that every competing small text generator ignored numbers entirely. A message like “happy birthday 2026” was half-styled: cute letters with giant numbers. We fixed that gap.</p></div></div>

      <div><h2 class="mb-4 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Complete Digit &amp; Symbol Mapping</h2><p class="mb-4 text-sm text-zinc-500 dark:text-zinc-400">All digits 0-9 and math symbols (+ - =) have both superscript and subscript equivalents. Full coverage, no gaps.</p><div class="overflow-x-auto rounded-xl border border-zinc-200 dark:border-zinc-800"><table class="w-full text-sm"><thead><tr class="border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/50"><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Char</th><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Superscript</th><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Subscript</th><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Char</th><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Superscript</th><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Subscript</th></tr></thead><tbody class="text-zinc-600 dark:text-zinc-400"><tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">0</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">⁰</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">₀</td><td class="px-4 py-2.5 font-mono text-base">5</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">⁵</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">₅</td></tr>
<tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">1</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">¹</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">₁</td><td class="px-4 py-2.5 font-mono text-base">6</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">⁶</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">₆</td></tr>
<tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">2</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">²</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">₂</td><td class="px-4 py-2.5 font-mono text-base">7</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">⁷</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">₇</td></tr>
<tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">3</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">³</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">₃</td><td class="px-4 py-2.5 font-mono text-base">8</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">⁸</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">₈</td></tr>
<tr><td class="px-4 py-2.5 font-mono text-base">4</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">⁴</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">₄</td><td class="px-4 py-2.5 font-mono text-base">9</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">⁹</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">₉</td></tr>
<tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">+</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">⁺</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">₊</td><td class="px-4 py-2.5 font-mono text-base">(</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">⁽</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">₍</td></tr>
<tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">-</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">⁻</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">₋</td><td class="px-4 py-2.5 font-mono text-base">)</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">⁾</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">₎</td></tr>
<tr><td class="px-4 py-2.5 font-mono text-base">=</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">⁼</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">₌</td></tr>
</tbody></table></div></div>

      <div><h2 class="mb-3 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Common Use Cases</h2><div class="space-y-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400"><p><strong>Dates &amp; Birthdays:</strong> “happy birthday 2026” becomes fully styled when the year is in superscript. Use for anniversaries and special dates in bios.</p><p><strong>Gaming IDs:</strong> Tags like “Gamer⁰⁷” or “Pro₂₀₂₆” use tiny numbers to create memorable identifiers that stand out in lobbies.</p><p><strong>Math &amp; Science:</strong> Exponents (x², aⁿ), chemical formulas (H₂O, CO₂), and simple equations with proper Unicode notation.</p><p><strong>Social Stats:</strong> Follower counts and statistics look cleaner in superscript. Combine with superscript letters for a cohesive aesthetic.</p></div></div>

      <!-- Platform Support -->
      <div>
        <h2 class="mb-3 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Platform Support for Tiny Numbers</h2>
        <div class="overflow-x-auto rounded-xl border border-zinc-200 dark:border-zinc-800">
          <table class="w-full text-sm">
            <thead><tr class="border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/50"><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Platform</th><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Superscript Numbers</th><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Subscript Numbers</th></tr></thead>
            <tbody class="text-zinc-600 dark:text-zinc-400">
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-3 font-medium text-zinc-700 dark:text-zinc-300">Instagram</td><td class="px-4 py-3 text-accent-600 font-medium">Full &#x2705;</td><td class="px-4 py-3 text-accent-600 font-medium">Full &#x2705;</td></tr>
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-3 font-medium text-zinc-700 dark:text-zinc-300">TikTok</td><td class="px-4 py-3 text-accent-600 font-medium">Full &#x2705;</td><td class="px-4 py-3 text-accent-600 font-medium">Full &#x2705;</td></tr>
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-3 font-medium text-zinc-700 dark:text-zinc-300">Discord</td><td class="px-4 py-3 text-accent-600 font-medium">Full &#x2705;</td><td class="px-4 py-3 text-accent-600 font-medium">Full &#x2705;</td></tr>
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-3 font-medium text-zinc-700 dark:text-zinc-300">Twitter/X</td><td class="px-4 py-3 text-accent-600 font-medium">Full &#x2705;</td><td class="px-4 py-3 text-accent-600 font-medium">Full &#x2705;</td></tr>
              <tr><td class="px-4 py-3 font-medium text-zinc-700 dark:text-zinc-300">Gaming</td><td class="px-4 py-3 text-accent-600 font-medium">Full &#x2705;</td><td class="px-4 py-3 text-accent-600 font-medium">Full &#x2705;</td></tr>
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-zinc-400 dark:text-zinc-500">Tiny numbers (superscript and subscript digits 0-9) have near-universal Unicode support — they work on virtually every modern platform and device.</p>
      </div>

      <div>
        <h2 class="mb-4 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Frequently Asked Questions</h2>
        <div class="space-y-2">
          <details class="group rounded-xl border border-zinc-200 dark:border-zinc-800">
            <summary class="cursor-pointer px-5 py-4 font-medium text-zinc-800 dark:text-zinc-200 text-sm">Can all numbers be converted to tiny format?</summary>
            <div class="px-5 pb-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">Yes, all digits 0-9 have both superscript and subscript equivalents in Unicode. Math symbols +, -, =, (, ) also have tiny versions. This is one of the few character sets in Unicode with 100% coverage — every digit and common symbol has a tiny counterpart.</div>
          </details>
          <details class="group rounded-xl border border-zinc-200 dark:border-zinc-800">
            <summary class="cursor-pointer px-5 py-4 font-medium text-zinc-800 dark:text-zinc-200 text-sm">Why don&apos;t other small text generators convert numbers?</summary>
            <div class="px-5 pb-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">Most tools focus only on letter conversion because that&apos;s the most common use case. We built tiny numbers support after noticing users had to manually handle dates, IDs, and stats — a &quot;happy birthday 2026&quot; message was only half-styled. It&apos;s a gap in the market we&apos;re happy to fill.</div>
          </details>
          <details class="group rounded-xl border border-zinc-200 dark:border-zinc-800">
            <summary class="cursor-pointer px-5 py-4 font-medium text-zinc-800 dark:text-zinc-200 text-sm">Can I mix tiny numbers with small text letters?</summary>
            <div class="px-5 pb-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">Yes. Use superscript letters with superscript numbers, or subscript letters with subscript numbers for a consistent look. Our <a href="/" class="text-accent-600 hover:underline">main tool</a> shows all 9 styles simultaneously so you can mix and match with one click.</div>
          </details>
          <details class="group rounded-xl border border-zinc-200 dark:border-zinc-800">
            <summary class="cursor-pointer px-5 py-4 font-medium text-zinc-800 dark:text-zinc-200 text-sm">Can I use tiny numbers for math homework?</summary>
            <div class="px-5 pb-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">Yes for simple exponents (x&#xB2;, a&#x207F;), basic equations, and chemical formulas (H&#x2082;O, CO&#x2082;). For complex mathematical typesetting, LaTeX is still the professional standard. Our tool is perfect for social media math, study notes, and casual formatting.</div>
          </details>
          <details class="group rounded-xl border border-zinc-200 dark:border-zinc-800">
            <summary class="cursor-pointer px-5 py-4 font-medium text-zinc-800 dark:text-zinc-200 text-sm">Do tiny numbers work on all platforms and devices?</summary>
            <div class="px-5 pb-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">Yes. Unicode superscript and subscript digits 0-9 have universal support across iOS, Android, Windows, macOS, and all major apps. They are among the most reliably displayed Unicode characters in existence — they were among the earliest characters standardized in Unicode 1.0.</div>
          </details>
        </div>
      </div>


      <!-- Related Guides -->
      <div class="rounded-xl border border-accent-200 bg-accent-50/30 p-5 dark:border-accent-900/30 dark:bg-accent-950/10">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-sm">📖</span>
          <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Related Guide</h3>
        </div>
        <a href="/blog/small-text-for-gaming/" class="text-sm font-medium text-accent-600 hover:text-accent-700 dark:text-accent-400 dark:hover:text-accent-300 hover:underline">Small Text for Gaming</a>
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">Game-by-game compatibility for Valorant, Fortnite, Steam, and more. Superscript numbers work on all modern games.</p>
      </div>

      <div class="rounded-xl border border-zinc-200 p-5 dark:border-zinc-800"><h3 class="mb-3 text-sm font-semibold text-zinc-900 dark:text-zinc-100">Try Other Styles</h3><div class="flex flex-wrap gap-2"><a href="/small-caps-text/" class="rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-medium text-zinc-600 hover:border-accent-300 hover:text-accent-600 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400">Small Caps</a><a href="/superscript-text/" class="rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-medium text-zinc-600 hover:border-accent-300 hover:text-accent-600 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400">Superscript</a><a href="/subscript-text/" class="rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-medium text-zinc-600 hover:border-accent-300 hover:text-accent-600 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400">Subscript</a><a href="/" class="rounded-lg bg-accent-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-accent-700">Full Generator →</a></div></div>
    </div>
  </main>
</Layout>

<script is:inline>
(function(){var SN={"0":"⁰","1":"¹","2":"²","3":"³","4":"⁴","5":"⁵","6":"⁶","7":"⁷","8":"⁸","9":"⁹","+":"⁺","-":"⁻","=":"⁼","(":"⁽",")":"⁾"};var SBN={"0":"₀","1":"₁","2":"₂","3":"₃","4":"₄","5":"₅","6":"₆","7":"₇","8":"₈","9":"₉","+":"₊","-":"₋","=":"₌","(":"₍",")":"₎"};function setup(id,map,def){var inp=document.getElementById("input-"+id),out=document.getElementById("output-"+id),cp=document.getElementById("copy-"+id),t;inp.addEventListener("input",function(){clearTimeout(t);t=setTimeout(function(){var v=inp.value||def,r="";for(var i=0;i<v.length;i++)r+=map[v[i]]||v[i];out.textContent=r},50)});cp.addEventListener("click",function(){if(out.textContent){navigator.clipboard.writeText(out.textContent);var o=cp.textContent;cp.textContent="✓ Copied!";setTimeout(function(){cp.textContent=o},1500)}})}setup("sup",SN,"2026");setup("sub",SBN,"H2O");})();
</script>
