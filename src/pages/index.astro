---
import Layout from "../layouts/Layout.astro";
import {
  convertAll,
  PLACEHOLDER_OUTPUTS,
  PLACEHOLDER_TEXT,
} from "../lib/unicode";
---

<Layout
  title="Small Text Generator - Copy & Paste (9 Styles) | Free Online"
  description="Free small text generator with 9 Unicode styles. Convert text to Small Caps, Superscript, Subscript, Numbers, Bubble, Bold, Italic &amp; Bold Italic. Instant copy-paste for Instagram, TikTok, Discord &amp; more."
  canonicalUrl="https://small-text-generator.com"
>
  <Fragment slot="extra-head">
 <!-- Open Graph -->
    <meta property="og:title" content="Small Text Generator - Copy & Paste 9 Free Styles" />
    <meta
      property="og:description"
      content="Convert normal text into 9 Unicode styles instantly. Includes small caps, superscript, subscript, numbers, bubble, bold, italic & bold italic. No ads, no sign-up. Works on Instagram, TikTok, Discord &amp; more."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://small-text-generator.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Small Text Generator - Copy & Paste 9 Free Styles" />
    <meta name="twitter:description" content="Convert normal text into 9 tiny Unicode styles instantly. No ads, no sign-up." />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Small Text Generator",
        "url": "https://small-text-generator.com",
        "description": "Convert normal text into small Unicode text with 9 different styles.",
        "applicationCategory": "UtilityApplication",
        "operatingSystem": "All",
        "dateModified": "2026-08-11"
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "SmallTextGen",
        "url": "https://small-text-generator.com",
        "logo": "https://small-text-generator.com/favicon.svg",
        "description": "Free online small text generator with 9 Unicode text styles. No ads, no sign-up."
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "HowTo",
        "name": "How to Use Small Text Generator",
        "step": [
          {"@type":"HowToStep","position":1,"name":"Type or paste your text","text":"Enter the text you want to convert in the input box at the top of the page."},
          {"@type":"HowToStep","position":2,"name":"View all 9 small text styles","text":"All 9 styles appear instantly as you type. No button clicks needed. Styles include Small Caps, Superscript, Subscript, Numbers, Bubble, Bold, Italic, and Bold Italic."},
          {"@type":"HowToStep","position":3,"name":"Choose your style and copy","text":"Click the Copy button on any style you prefer. You will see a green confirmation that the text was copied to your clipboard."},
          {"@type":"HowToStep","position":4,"name":"Paste anywhere","text":"Paste the copied text into Instagram bios, TikTok names, Discord messages, gaming nicknames, Twitter/X posts, YouTube comments, or any app that supports text input."}
        ]
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What is a small text generator?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A small text generator converts regular text into tiny Unicode characters that look smaller but can be copied and pasted anywhere."
            }
          },
          {
            "@type": "Question",
            "name": "How does small text work?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Small text uses special Unicode characters that are designed to look smaller than normal letters. They are real text characters, not a font, so you can copy and paste them anywhere."
            }
          },
          {
            "@type": "Question",
            "name": "Where can I use small text?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Use small text on Instagram bios, TikTok usernames, Twitter/X posts, Discord messages, gaming nicknames, YouTube comments, and anywhere that supports Unicode text."
            }
          },
          {
            "@type": "Question",
            "name": "Can I generate small numbers?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes! Our tool includes a Numbers style that converts digits to superscript format, and you can also generate subscript numbers for dates, IDs, and more."
            }
          },
          {
            "@type": "Question",
            "name": "Is this tool really free?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, completely free. No sign-up, no ads, no hidden fees. Just a clean, simple tool for generating small text."
            }
          },
          {
            "@type": "Question",
            "name": "Does this tool work on mobile?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Absolutely. Our small text generator is designed mobile-first. The input, outputs, and copy buttons work seamlessly on phones and tablets."
            }
          },
          {
            "@type": "Question",
            "name": "Can I use small text in my Instagram bio?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes! Instagram fully supports Unicode characters, and our small text works perfectly in Instagram bios. Simply generate, copy, and paste."
            }
          },
          {
            "@type": "Question",
            "name": "Is small text the same as changing font size?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. Changing font size adjusts regular characters in a document. Small text uses entirely different Unicode characters that are drawn smaller by design, so they work everywhere."
            }
          },
          {
            "@type": "Question",
            "name": "Can I mix different small text styles?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes! Copy different styles and combine them however you like. Use superscript letters with superscript numbers for a fully styled message."
            }
          },
          {
            "@type": "Question",
            "name": "Will search engines read my small text as normal letters?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No, search engines may not interpret Unicode small text as the letters they visually represent. For content you want indexed, use regular text instead."
            }
          },
          {
            "@type": "Question",
            "name": "What's the difference between small text and fancy text?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Small text styles (Small Caps, Superscript, Subscript) make text look physically smaller using scaled Unicode characters. Fancy styles (Bubble, Bold, Italic) change visual style while keeping normal proportions. Both are real Unicode characters you can copy anywhere."
            }
          },
          {
            "@type": "Question",
            "name": "Can I use this as a font generator for Instagram or TikTok?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes! Use it as a free alternative to Instagram font generators and TikTok font changers. The Unicode characters paste into any app that supports text input — no font installation required."
            }
          },
          {
            "@type": "Question",
            "name": "Do I need to download anything?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No downloads, apps, or extensions needed. The tool works in your browser on any device. Everything runs locally — your text never leaves your device."
            }
          }
      ]
      }
    </script>  </Fragment><!-- ===== HEADER ===== -->
  <header
    class="sticky top-0 z-50 border-b border-zinc-200/80 bg-zinc-50/90 backdrop-blur-md dark:border-zinc-800/80 dark:bg-zinc-950/90"
  >
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3">
      <a href="/" class="flex items-center gap-2.5 font-semibold text-lg tracking-tight text-zinc-900 dark:text-zinc-100">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent-600 text-white text-sm font-bold"
          >s</span
        >
        <span class="hidden sm:inline">SmallTextGen</span>
      </a>
      <nav class="flex items-center gap-4 text-sm font-medium text-zinc-600 dark:text-zinc-400">
        <a href="#tool" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Tool</a>
        <a href="/blog/small-text-for-social-media" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Blog</a>
        <a href="#faq" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">FAQ</a>
      </nav>
    </div>
  </header>

  <!-- ===== HERO / TOOL SECTION ===== -->
  <main id="tool" class="mx-auto max-w-5xl px-4 pt-12 pb-8">
    <div class="mb-4 flex flex-wrap items-center gap-3">
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-accent-100 px-3 py-1 text-xs font-semibold text-accent-700 dark:bg-accent-900/40 dark:text-accent-300"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-sparkles"
          ><path
            d="M11.017 2.816a1 1 0 0 1 1.966 0l1.003 4.296a1 1 0 0 0 .902.902l4.296 1.003a1 1 0 0 1 0 1.966l-4.296 1.003a1 1 0 0 0-.902.902l-1.003 4.296a1 1 0 0 1-1.966 0l-1.003-4.296a1 1 0 0 0-.902-.902l-4.296-1.003a1 1 0 0 1 0-1.966l4.296-1.003a1 1 0 0 0 .902-.902z"
          ></path
          ><path
            d="M19.017 2.816a1 1 0 0 1 1.966 0l.334 1.432a1 1 0 0 0 .668.668l1.432.334a1 1 0 0 1 0 1.966l-1.432.334a1 1 0 0 0-.668.668l-.334 1.432a1 1 0 0 1-1.966 0l-.334-1.432a1 1 0 0 0-.668-.668l-1.432-.334a1 1 0 0 1 0-1.966l1.432-.334a1 1 0 0 0 .668-.668z"
          ></path></svg
        >
        9 Styles &middot; Numbers &amp; Fancy Text
      </span>
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-zinc-200/70 px-3 py-1 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400"
      >
        No Ads &middot; No Sign-up &middot; Instant &middot; Private
      </span>
    </div>

    <h1
      class="mb-3 text-4xl font-bold tracking-tighter text-zinc-900 dark:text-zinc-100 md:text-5xl"
    >
      Small Text Generator
    </h1>
    <h2 class="mb-2 text-lg font-medium text-zinc-500 dark:text-zinc-400">Convert normal text into 9 free Unicode styles — instant, private, no ads</h2>
        <div class="flex items-center gap-2">
      <button id="compare-toggle" class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-500 transition-all hover:border-accent-300 hover:text-accent-600 active:scale-[0.97] dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400" aria-label="Toggle before/after comparison">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-columns-2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M12 3v18"/></svg>
        Compare
      </button>
    </div>

<p class="mb-4 max-w-2xl text-base leading-relaxed text-zinc-500 dark:text-zinc-400">
      Type below and get 9 instant text styles. One-click copy. Works on
      Instagram, TikTok, Discord, gaming nicks, and everywhere else.
    </p>

    <!-- ===== QUICK-START PRESETS ===== -->
    <div class="mb-5 flex flex-wrap items-center gap-2">
      <span class="text-xs font-medium text-zinc-400 dark:text-zinc-500">Try:</span>
      <button class="try-preset inline-flex items-center rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-600 transition-all hover:border-accent-300 hover:text-accent-600 hover:bg-accent-50 active:scale-[0.97] dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400" data-text="hello world">hello world</button>
      <button class="try-preset inline-flex items-center rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-600 transition-all hover:border-accent-300 hover:text-accent-600 hover:bg-accent-50 active:scale-[0.97] dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400" data-text="happy birthday 2026">happy birthday 2026</button>
      <button class="try-preset inline-flex items-center rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-600 transition-all hover:border-accent-300 hover:text-accent-600 hover:bg-accent-50 active:scale-[0.97] dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400" data-text="GAMERPRO">GAMERPRO</button>
    </div>

    <!-- ===== INPUT ===== -->
    <div class="mb-1">
      <textarea
        id="input"
        rows="2"
        placeholder="Type or paste your text here..."
        class="w-full resize-none rounded-xl border border-zinc-300 bg-white px-5 py-4 text-lg font-medium text-zinc-900 placeholder:text-zinc-400 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/20 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:placeholder:text-zinc-500 dark:focus:border-accent-500"
        autofocus
      ></textarea>
      <div class="mt-1.5 flex items-center justify-between"><span id="char-count" class="text-xs text-zinc-400 dark:text-zinc-500">0 characters</span><span id="platform-limit" class="text-xs text-zinc-300 dark:text-zinc-600"></span></div>
    </div>


    <!-- ===== PLATFORM PICKER ===== -->
    <div class="mt-3 mb-5 flex flex-wrap items-center gap-1.5" id="platform-picker">
      <span class="text-xs font-medium text-zinc-400 dark:text-zinc-500 mr-1 hidden sm:inline">I&apos;m using this on:</span>
      <button class="platform-pick inline-flex items-center gap-1 rounded-full border px-3 py-1.5 text-xs font-semibold transition-all bg-accent-600 text-white border-accent-600 shadow-sm" data-platform="all">All</button>
      <button class="platform-pick inline-flex items-center gap-1 rounded-full border px-3 py-1.5 text-xs font-medium transition-all border-zinc-200 text-zinc-500 hover:border-zinc-300 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-zinc-600 dark:hover:bg-zinc-800/50" data-platform="instagram">Instagram</button>
      <button class="platform-pick inline-flex items-center gap-1 rounded-full border px-3 py-1.5 text-xs font-medium transition-all border-zinc-200 text-zinc-500 hover:border-zinc-300 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-zinc-600 dark:hover:bg-zinc-800/50" data-platform="discord">Discord</button>
      <button class="platform-pick inline-flex items-center gap-1 rounded-full border px-3 py-1.5 text-xs font-medium transition-all border-zinc-200 text-zinc-500 hover:border-zinc-300 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-zinc-600 dark:hover:bg-zinc-800/50" data-platform="tiktok">TikTok</button>
      <button class="platform-pick inline-flex items-center gap-1 rounded-full border px-3 py-1.5 text-xs font-medium transition-all border-zinc-200 text-zinc-500 hover:border-zinc-300 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-zinc-600 dark:hover:bg-zinc-800/50" data-platform="gaming">Gaming</button>
      <span class="hidden sm:inline-flex items-center gap-1 ml-2 text-xs text-zinc-300 dark:text-zinc-600">
        <span class="inline-block w-1 h-1 rounded-full bg-zinc-300 dark:bg-zinc-600"></span>
        best style auto-highlighted
      </span>
    </div>
    <!-- ===== OUTPUT ROWS ===== -->
    <div id="outputs" class="space-y-1">
      {
        PLACEHOLDER_OUTPUTS.map((style, i) => (
          <>
            {i === 0 && <div class="mt-3 mb-0.5 text-[11px] font-semibold uppercase tracking-widest text-zinc-300 dark:text-zinc-600">Small Text Styles</div>}
            {i === 3 && <div class="mt-4 mb-0.5 text-[11px] font-semibold uppercase tracking-widest text-zinc-300 dark:text-zinc-600">Numbers</div>}
            {i === 5 && <div class="mt-4 mb-0.5 text-[11px] font-semibold uppercase tracking-widest text-zinc-300 dark:text-zinc-600">Fancy Text Styles</div>}
          <div
            class="group relative overflow-hidden rounded-xl border border-zinc-200 bg-white p-4 transition-all hover:border-zinc-300 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700"
          >
            <div class="mb-1.5 flex items-center gap-3">
              <span
                class="text-xs font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500"
              >
                {style.label}
              </span>
              <span class="text-xs text-zinc-400 dark:text-zinc-500">
                {style.description}
              </span>
            </div>
              <div class="orig-text hidden text-xs text-zinc-300 dark:text-zinc-600 line-through leading-none mb-0.5 break-all" data-style={style.slug}></div>
            <div
              class="style-output min-h-[1.8em] break-all py-0.5 text-2xl font-medium tracking-normal text-zinc-800 dark:text-zinc-200"
              data-style={style.slug}
             
            >
              {style.text}
            </div>
            <button
              class="copy-btn absolute top-4 right-4 flex items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3 py-2 text-xs font-medium text-zinc-500 opacity-100 transition-all hover:border-accent-300 hover:text-accent-600 active:scale-[0.97] sm:opacity-0 sm:group-hover:opacity-100 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400"
              data-style={style.slug}
              aria-label={"Copy " + style.label}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-copy"
                ><rect
                  width="14"
                  height="14"
                  x="8"
                  y="8"
                  rx="2"
                  ry="2"
                ></rect
                ><path
                  d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                ></path></svg
              >
              Copy
            </button>
            <div
              class="copied-indicator absolute top-4 right-4 hidden items-center gap-1 rounded-lg bg-accent-100 px-2.5 py-1.5 text-xs font-semibold text-accent-700 dark:bg-accent-900/40 dark:text-accent-300"
              data-style={style.slug}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-check"
                ><path d="M20 6 9 17l-5-5"></path></svg
              >
              Copied!
            </div>
          </div>
          </>
        ))
      }
    </div>

    <!-- Copy All -->
    <div class="mt-4 flex justify-end">
      <div class="relative inline-flex items-center gap-2">
        <button id="copy-all-btn" class="flex items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3 py-2 text-xs font-medium text-zinc-500 transition-all hover:border-accent-300 hover:text-accent-600 active:scale-[0.97] dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 15 2 2 4-4"/><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          Copy All (9 styles)
        </button>
        <div id="copy-all-ok" class="hidden items-center gap-1 rounded-lg bg-accent-100 px-3 py-2 text-xs font-semibold text-accent-700 dark:bg-accent-900/40 dark:text-accent-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> All 9 copied!
        </div>
        <span class="hidden sm:inline text-xs text-zinc-300 dark:text-zinc-600">Ctrl+Shift+C</span>
      </div>
    </div>


    <!-- ===== SCENE SIMULATOR ===== -->
    <div class="mt-12" id="scene-simulator">
      <h2
        class="mb-2 text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100"
      >
        See it in action
      </h2>
      <p class="mb-5 text-sm text-zinc-500 dark:text-zinc-400">
        Your small text, shown exactly as it appears on real platforms.
      </p>
      <div class="grid gap-4 sm:grid-cols-3">
        <!-- Instagram Bio -->
        <div class="rounded-xl border border-zinc-200 bg-white overflow-hidden dark:border-zinc-800 dark:bg-zinc-900">
          <div class="bg-gradient-to-r from-purple-500 via-pink-500 to-orange-400 px-4 py-2">
            <div class="flex items-center justify-between"><span class="text-xs font-semibold text-white">Instagram Bio</span><button class="scene-suggest text-white/70 hover:text-white text-[10px] font-medium transition-colors" data-text="hello world">try it</button></div>
          </div>
          <div class="p-4">
            <div class="flex items-center gap-3">
              <div class="h-10 w-10 rounded-full bg-zinc-200 flex-shrink-0 dark:bg-zinc-700"></div>
              <div class="min-w-0">
                <div class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 truncate">yourname</div>
                <div class="scene-preview text-xs text-zinc-500 dark:text-zinc-400 break-all" data-scene="instagram" >&#x1D57;&#x2B3;&#x1D43;&#x2E1;&#x1D49;&#x1D58; &#x1D52;&#x1D52;&#x2E1; &#x02B0;&#x1D49;&#x1D58;&#x1D58;&#x1D52; &#x207F;&#x02B8;&#x1D9C;</div>
              </div>
            </div>
          </div>
        </div>
        <!-- Twitter/X Name -->
        <div class="rounded-xl border border-zinc-200 bg-white overflow-hidden dark:border-zinc-800 dark:bg-zinc-900">
          <div class="bg-zinc-900 px-4 py-2 dark:bg-zinc-800">
            <div class="flex items-center justify-between"><span class="text-xs font-semibold text-white">Twitter / X Name</span><button class="scene-suggest text-white/70 hover:text-white text-[10px] font-medium transition-colors" data-text="GAMERPRO">try it</button></div>
          </div>
          <div class="p-4">
            <div class="flex items-center gap-2">
              <span class="text-xs text-zinc-400 dark:text-zinc-500">@</span>
              <span class="scene-preview text-sm font-semibold text-zinc-900 dark:text-zinc-100 break-all" data-scene="twitter" >&#x1D2C;&#x1D2E;&#x1D30;&#x1D31;&#x1D3F;&#x1D3E;&#x1D40;</span>
            </div>
          </div>
        </div>
