---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Superscript Text Generator - Complete A-Z Mapping | SmallTextGen"
  description="Generate superscript text with our complete A-Z Unicode mapping table. The most popular small text style for social media. 23 of 26 letters supported. Free instant tool."
  canonicalUrl="https://small-text-gen.com/superscript-text"
>
  <Fragment slot="extra-head">
    <meta property="og:title" content="Superscript Text Generator - Complete A-Z Mapping | SmallTextGen" />
    <meta property="og:description" content="Generate superscript text with our complete A-Z Unicode mapping table. Free instant tool." />
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"WebApplication","name":"Superscript Text Generator","url":"https://small-text-gen.com/superscript-text","description":"Convert text into Unicode superscript characters. Complete A-Z mapping table. The most popular small text style for social media.","applicationCategory":"UtilityApplication","operatingSystem":"All","dateModified":"2026-08-11"}
    </script>
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How many letters have superscript equivalents?","acceptedAnswer":{"@type":"Answer","text":"23 of 26 lowercase letters have dedicated superscript characters. The letters b, d, and g use alternative mappings. Most uppercase letters also have superscript forms, though they are less commonly used."}},{"@type":"Question","name":"Is superscript the best style for social media?","acceptedAnswer":{"@type":"Answer","text":"Yes. Superscript renders correctly on Instagram, TikTok, Twitter/X, Discord, and virtually every other platform. It is the safest choice for maximum cross-platform compatibility."}},{"@type":"Question","name":"Can I use superscript for math formulas?","acceptedAnswer":{"@type":"Answer","text":"Yes, superscript is ideal for exponents and math notation. Use the superscript numbers style for x&#x00b2;, a&#x207F;, and similar expressions. Our main tool also handles math symbols like +, -, =, (, )."}}]}
    </script>
  </Fragment>
  <header class="sticky top-0 z-50 border-b border-zinc-200/80 bg-zinc-50/90 backdrop-blur-md dark:border-zinc-800/80 dark:bg-zinc-950/90">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
      <a href="/" class="flex items-center gap-2.5 font-semibold text-lg tracking-tight text-zinc-900 dark:text-zinc-100">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent-600 text-white text-sm font-bold">s</span>
        <span class="hidden sm:inline">SmallTextGen</span>
      </a>
      <nav class="flex items-center gap-4 text-sm font-medium text-zinc-500 dark:text-zinc-400">
        <a href="/" class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors">Main Tool</a>
        <a href="/small-caps-text" class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors">Small Caps</a>
        <a href="/subscript-text" class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors">Subscript</a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-4 pt-12 pb-16">
    <div class="mb-2 inline-flex items-center gap-1.5 rounded-full bg-accent-100 px-3 py-1 text-xs font-semibold text-accent-700 dark:bg-accent-900/40 dark:text-accent-300">Most Popular Style</div>
    <h1 class="mb-4 text-4xl font-bold tracking-tighter text-zinc-900 dark:text-zinc-100">Superscript Text Generator</h1>
    <p class="mb-8 text-base leading-relaxed text-zinc-500 dark:text-zinc-400">Generate tiny raised letters. The most popular small text style for Instagram bios, TikTok names, and Discord messages. Complete Unicode mapping table with all 26 letters.</p>
    <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-900">
      <textarea id="input" rows="2" placeholder="Type or paste your text here..." class="w-full resize-none rounded-lg border border-zinc-300 bg-white px-4 py-3 text-base font-medium text-zinc-900 placeholder:text-zinc-400 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/20 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:placeholder:text-zinc-500" autofocus></textarea>
      <div class="mt-3 flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">Superscript Output</span>
        <div class="flex items-center gap-2">
          <button id="copy-btn" class="flex items-center gap-1 rounded-lg border border-zinc-200 bg-white px-2.5 py-1.5 text-xs font-medium text-zinc-500 hover:border-accent-300 hover:text-accent-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400">Copy</button>
          <span id="copied" class="hidden text-xs font-semibold text-accent-600 dark:text-accent-400">Copied!</span>
        </div>
      </div>
      <div id="output" class="mt-2 min-h-[2em] break-all rounded-lg bg-zinc-50 px-4 py-3 text-2xl font-medium text-zinc-800 dark:bg-zinc-800/50 dark:text-zinc-200" style="font-family:system-ui">hello world</div>
    </div>

    <div class="mt-14 space-y-10">
      <div>
        <h2 class="mb-3 text-xl font-semibold text-zinc-900 dark:text-zinc-100">What Is Superscript Text?</h2>
        <div class="space-y-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
          <p>Superscript characters are small letters and numbers that sit <strong>above the baseline</strong> of regular text. They appear in math (x2), footnotes (1), and trademarks (TM). The Unicode standard includes superscript versions of most letters, making this the <strong>most versatile small text style</strong>.</p>
          <p>There are two types: lowercase superscript (for aesthetic text like bios) and uppercase superscript (for display names and branding). Both are real Unicode characters, not font formatting, so they work everywhere text input is accepted.</p>
          <p><strong>Why superscript is #1:</strong> It renders correctly on more platforms than any other small text style. Instagram, TikTok, Discord, Twitter/X, YouTube, WhatsApp — all display superscript cleanly. It's the safest choice for maximum cross-platform compatibility.</p>
        </div>
      </div>

      <div>
        <h2 class="mb-4 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Complete A-Z Superscript Mapping</h2>
        <p class="mb-4 text-sm text-zinc-500 dark:text-zinc-400">23 of 26 letters have dedicated superscript characters. Letters without dedicated equivalents are mapped to visually similar alternates.</p>
        <div class="overflow-x-auto rounded-xl border border-zinc-200 dark:border-zinc-800">
          <table class="w-full text-sm">
            <thead><tr class="border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/50"><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Letter</th><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Superscript</th><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Letter</th><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Superscript</th></tr></thead>
            <tbody class="text-zinc-600 dark:text-zinc-400">
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">a</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x1D43;</td><td class="px-4 py-2.5 font-mono text-base">n</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x207F;</td></tr>
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">b</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x1D47;</td><td class="px-4 py-2.5 font-mono text-base">o</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x1D52;</td></tr>
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">c</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x1D9C;</td><td class="px-4 py-2.5 font-mono text-base">p</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x1D56;</td></tr>
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">d</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x1D48;</td><td class="px-4 py-2.5 font-mono text-base">q</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x146B;*</td></tr>
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">e</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x1D49;</td><td class="px-4 py-2.5 font-mono text-base">r</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x02B3;</td></tr>
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">f</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x1DA0;</td><td class="px-4 py-2.5 font-mono text-base">s</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x02E2;</td></tr>
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">g</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x1D4D;</td><td class="px-4 py-2.5 font-mono text-base">t</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x1D57;</td></tr>
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">h</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x02B0;</td><td class="px-4 py-2.5 font-mono text-base">u</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x1D58;</td></tr>
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">i</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x2071;</td><td class="px-4 py-2.5 font-mono text-base">v</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x1D5B;</td></tr>
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">j</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x02B2;</td><td class="px-4 py-2.5 font-mono text-base">w</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x02B7;</td></tr>
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">k</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x1D4F;</td><td class="px-4 py-2.5 font-mono text-base">x</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x02E3;</td></tr>
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">l</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x02E1;</td><td class="px-4 py-2.5 font-mono text-base">y</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x02B8;</td></tr>
              <tr><td class="px-4 py-2.5 font-mono text-base">m</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x1D50;</td><td class="px-4 py-2.5 font-mono text-base">z</td><td class="px-4 py-2.5 text-lg" style="font-family:system-ui">&#x1DBB;</td></tr>
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-zinc-400 dark:text-zinc-500">* Characters marked with an asterisk use alternative Unicode characters where a dedicated superscript does not exist.</p>
      </div>

      <div>
        <h2 class="mb-3 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Platform Compatibility</h2>
        <div class="overflow-x-auto rounded-xl border border-zinc-200 dark:border-zinc-800">
          <table class="w-full text-sm">
            <thead><tr class="border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/50"><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Platform</th><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Compatibility</th><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Best Use</th></tr></thead>
            <tbody class="text-zinc-600 dark:text-zinc-400">
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-3 font-medium text-zinc-700 dark:text-zinc-300">Instagram</td><td class="px-4 py-3 text-accent-600 font-medium">Excellent</td><td class="px-4 py-3">Bio, name, captions — the #1 choice</td></tr>
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-3 font-medium text-zinc-700 dark:text-zinc-300">TikTok</td><td class="px-4 py-3 text-accent-600 font-medium">Excellent</td><td class="px-4 py-3">Bio and name fields</td></tr>
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-3 font-medium text-zinc-700 dark:text-zinc-300">Discord</td><td class="px-4 py-3 text-accent-600 font-medium">Excellent</td><td class="px-4 py-3">Messages and custom status</td></tr>
              <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-3 font-medium text-zinc-700 dark:text-zinc-300">Twitter/X</td><td class="px-4 py-3 text-accent-600 font-medium">Excellent</td><td class="px-4 py-3">Display name and posts</td></tr>
              <tr><td class="px-4 py-3 font-medium text-zinc-700 dark:text-zinc-300">Gaming</td><td class="px-4 py-3 text-accent-600 font-medium">Good</td><td class="px-4 py-3">Nicknames on most modern games</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Common Use Cases -->
      <div>
        <h2 class="mb-4 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Common Uses for Superscript Text</h2>
        <div class="space-y-4 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
          <div>
            <h3 class="text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5">Instagram &amp; TikTok Bios</h3>
            <p>Superscript is the most popular choice for social media profiles. A bio line like "&#x1D9C;&#x02B3;&#x1D49;&#x1D43;&#x1D57;&#x1D52;&#x02B3; &#x00B7; &#x1D9C;&#x1D52;&#x1DA0;&#x1DA0;&#x1D49;&#x1D49; &#x1D43;&#x1D48;&#x1D48;&#x1D49;&#x1D9C;&#x1D57; &#x00B7; NYC" creates a clean, minimal aesthetic that stands out in any profile grid. Superscript renders cleanly on both iOS and Android Instagram.</p>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5">Discord Messages &amp; Status</h3>
            <p>Discord users treat superscript text as a "whisper" — it&apos;s become part of the platform&apos;s culture. Use it for inside jokes, subtle status updates, or to add a second voice to your messages. Combine superscript with Discord&apos;s native markdown (**bold**, *italic*) for layered formatting.</p>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5">Math &amp; Science Notation</h3>
            <p>Superscript is the standard for mathematical exponents (x&#xB2;, a&#x207F;), ordinal indicators (1&#x02E2;&#x1D57;, 2&#x207F;&#x1D48;), and scientific notation. Combine superscript letters with superscript numbers for complete formatted expressions.</p>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5">Dates &amp; Anniversary Tags</h3>
            <p>"Happy Birthday &#xB2;&#x2070;&#xB2;&#x2076;", "Est. &#xB2;&#x2070;&#xB2;&#xB0;", "Class of &#xB2;&#x2070;&#xB2;&#xB7;" — superscript numbers make dates and years look intentional and designed. Combine with superscript letters for fully styled celebratory messages.</p>
          </div>
        </div>
      </div>

      <!-- FAQ -->
      <div>
        <h2 class="mb-4 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Frequently Asked Questions</h2>
        <div class="space-y-2">
          <details class="group rounded-xl border border-zinc-200 dark:border-zinc-800">
            <summary class="cursor-pointer px-5 py-4 font-medium text-zinc-800 dark:text-zinc-200 text-sm">How many letters have superscript equivalents?</summary>
            <div class="px-5 pb-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">23 of 26 lowercase letters (a-z) have dedicated Unicode superscript characters. Letters q, c, f, g use alternative mappings from related Unicode blocks. Most uppercase letters also have superscript forms, though they are less commonly used in social media contexts.</div>
          </details>
          <details class="group rounded-xl border border-zinc-200 dark:border-zinc-800">
            <summary class="cursor-pointer px-5 py-4 font-medium text-zinc-800 dark:text-zinc-200 text-sm">Is superscript the best style for social media?</summary>
            <div class="px-5 pb-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">Yes. Superscript renders correctly on Instagram, TikTok, Twitter/X, Discord, YouTube, WhatsApp, and virtually every other platform. It has the widest platform support of any small text style and is the safest choice for maximum cross-platform compatibility.</div>
          </details>
          <details class="group rounded-xl border border-zinc-200 dark:border-zinc-800">
            <summary class="cursor-pointer px-5 py-4 font-medium text-zinc-800 dark:text-zinc-200 text-sm">Is superscript the same as making text smaller?</summary>
            <div class="px-5 pb-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">No. Superscript uses completely different Unicode characters that are designed to appear raised and smaller. Changing font size keeps the same characters but adjusts their scale — and only works inside apps that support text formatting. Superscript characters work everywhere text input is accepted.</div>
          </details>
          <details class="group rounded-xl border border-zinc-200 dark:border-zinc-800">
            <summary class="cursor-pointer px-5 py-4 font-medium text-zinc-800 dark:text-zinc-200 text-sm">Can I use superscript for math formulas?</summary>
            <div class="px-5 pb-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">Yes, superscript is ideal for exponents and math notation. Use superscript numbers for x&#xB2;, a&#x207F;, and similar expressions. Our main tool also handles math symbols like +, -, =, (, ) in both superscript and subscript format. For complex equations, LaTeX is still preferred, but for simple exponents and social media math, superscript works great.</div>
          </details>
          <details class="group rounded-xl border border-zinc-200 dark:border-zinc-800">
            <summary class="cursor-pointer px-5 py-4 font-medium text-zinc-800 dark:text-zinc-200 text-sm">Which letters don&apos;t have superscript equivalents?</summary>
            <div class="px-5 pb-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">Letters q, c, f, g have less common or alternative mappings from other Unicode blocks. Our tool uses the best available visual substitute for each. If you need 100% letter fidelity, Small Caps is the only style with complete A-Z coverage — all 26 letters have dedicated small caps characters.</div>
          </details>
        </div>
      </div>

      <div class="rounded-xl border border-zinc-200 p-5 dark:border-zinc-800">

      <!-- Related Guides -->
      <div class="rounded-xl border border-accent-200 bg-accent-50/30 p-5 dark:border-accent-900/30 dark:bg-accent-950/10">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-sm">📖</span>
          <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Related Guide</h3>
        </div>
        <a href="/blog/small-text-for-social-media" class="text-sm font-medium text-accent-600 hover:text-accent-700 dark:text-accent-400 dark:hover:text-accent-300 hover:underline">Superscript on Social Media</a>
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">Instagram, TikTok, Twitter/X &mdash; how to use superscript text on every social platform.</p>
      </div>

        <h3 class="mb-3 text-sm font-semibold text-zinc-900 dark:text-zinc-100">Try Other Styles</h3>
        <div class="flex flex-wrap gap-2">
          <a href="/small-caps-text" class="rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-medium text-zinc-600 hover:border-accent-300 hover:text-accent-600 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400">Small Caps</a>
          <a href="/subscript-text" class="rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-medium text-zinc-600 hover:border-accent-300 hover:text-accent-600 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400">Subscript</a>
          <a href="/tiny-numbers" class="rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-medium text-zinc-600 hover:border-accent-300 hover:text-accent-600 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400">Tiny Numbers</a>
          <a href="/" class="rounded-lg bg-accent-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-accent-700">Full Generator</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
(function(){
  var SL={"a":"\u1D43","b":"\u1D47","c":"\u1D9C","d":"\u1D48","e":"\u1D49","f":"\u1DA0","g":"\u1D4D","h":"\u02B0","i":"\u2071","j":"\u02B2","k":"\u1D4F","l":"\u02E1","m":"\u1D50","n":"\u207F","o":"\u1D52","p":"\u1D56","q":"\u146B","r":"\u02B3","s":"\u02E2","t":"\u1D57","u":"\u1D58","v":"\u1D5B","w":"\u02B7","x":"\u02E3","y":"\u02B8","z":"\u1DBB"};
  var inp=document.getElementById("input"),out=document.getElementById("output"),cp=document.getElementById("copy-btn"),ok=document.getElementById("copied"),t;
  inp.addEventListener("input",function(){clearTimeout(t);t=setTimeout(function(){var v=inp.value||"hello world",r="";for(var i=0;i<v.length;i++)r+=SL[v[i].toLowerCase()]||v[i];out.textContent=r},50)});
  cp.addEventListener("click",function(){if(out.textContent){navigator.clipboard.writeText(out.textContent);cp.classList.add("hidden");ok.classList.remove("hidden");setTimeout(function(){ok.classList.add("hidden");cp.classList.remove("hidden")},1500)}});
})();
</script>


