---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Subscript Text Generator - Complete Mapping Table | SmallTextGen"
  description="Generate subscript text with our complete character mapping table. 18 of 26 letters supported. The rarest small text style for a unique, subtle look. Free instant tool."
  canonicalUrl="https://small-text-gen.com/subscript-text"
>
  <Fragment slot="extra-head">
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"WebApplication","name":"Subscript Text Generator","url":"https://small-text-gen.com/subscript-text","description":"Convert text into Unicode subscript characters. Includes complete mapping table with known character gaps.","applicationCategory":"UtilityApplication","operatingSystem":"All","dateModified":"2026-08-11"}</script>
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Why are some letters missing in subscript?","acceptedAnswer":{"@type":"Answer","text":"The Unicode standard has fewer subscript characters than superscript or small caps. Only 18 of 26 letters have dedicated subscript equivalents. Letters b, c, d, f, g, q, w, y, z remain as regular text."}},{"@type":"Question","name":"Is subscript still worth using if letters are missing?","acceptedAnswer":{"@type":"Answer","text":"Yes, for short text using mostly supported letters (vowels and consonants h, k, l, m, n, p, r, s, t, v, x), subscript creates a distinctive look. Always test before using publicly."}},{"@type":"Question","name":"Can I use subscript for chemistry formulas?","acceptedAnswer":{"@type":"Answer","text":"Yes! Subscript numbers handle H2O, CO2, and other formulas perfectly. Combine subscript letters with subscript numbers for complete scientific notation."}},{"@type":"Question","name":"Which letters are supported in subscript?","acceptedAnswer":{"@type":"Answer","text":"18 letters are supported: a, e, h, i, j, k, l, m, n, o, p, r, s, t, u, v, x. Missing: b, c, d, f, g, q, w, y, z. Unsupported letters stay as regular text."}},{"@type":"Question","name":"Does subscript work on all platforms?","acceptedAnswer":{"@type":"Answer","text":"Subscript has the most limited platform support. It works partially on Instagram and is limited on Discord and gaming. For reliable cross-platform use, superscript is the safer choice."}}]}</script>
  </Fragment>

  <header class="sticky top-0 z-50 border-b border-zinc-200/80 bg-zinc-50/90 backdrop-blur-md dark:border-zinc-800/80 dark:bg-zinc-950/90">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
      <a href="/" class="flex items-center gap-2.5 font-semibold text-lg tracking-tight text-zinc-900 dark:text-zinc-100"><span class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent-600 text-white text-sm font-bold">s</span><span class="hidden sm:inline">SmallTextGen</span></a>
      <nav class="flex items-center gap-4 text-sm font-medium text-zinc-500 dark:text-zinc-400"><a href="/" class="hover:text-accent-600 dark:hover:text-accent-400">Main Tool</a><a href="/small-caps-text" class="hover:text-accent-600 dark:hover:text-accent-400">Small Caps</a><a href="/superscript-text" class="hover:text-accent-600 dark:hover:text-accent-400">Superscript</a></nav>
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-4 pt-12 pb-16">
    <div class="mb-2 inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">Limited Characters — 18 of 26 Letters</div>
    <h1 class="mb-4 text-4xl font-bold tracking-tighter text-zinc-900 dark:text-zinc-100">Subscript Text Generator</h1>
    <p class="mb-8 text-base leading-relaxed text-zinc-500 dark:text-zinc-400">Generate tiny lowered letters. Only 18 letters have Unicode subscript equivalents — we show you exactly which ones work.</p>

    <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-900">
      <textarea id="input" rows="2" placeholder="Type or paste your text here..." class="w-full resize-none rounded-lg border border-zinc-300 bg-white px-4 py-3 text-base font-medium text-zinc-900 placeholder:text-zinc-400 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/20 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:placeholder:text-zinc-500" autofocus></textarea>
      <div class="mt-3 flex items-center justify-between"><span class="text-xs font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">Subscript Output</span><div class="flex items-center gap-2"><button id="copy-btn" class="flex items-center gap-1 rounded-lg border border-zinc-200 bg-white px-2.5 py-1.5 text-xs font-medium text-zinc-500 hover:border-accent-300 hover:text-accent-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400">Copy</button><span id="copied" class="hidden text-xs font-semibold text-accent-600 dark:text-accent-400">✓ Copied!</span></div></div>
      <div id="output" class="mt-2 min-h-[2em] break-all rounded-lg bg-zinc-50 px-4 py-3 text-2xl font-medium text-zinc-800 dark:bg-zinc-800/50 dark:text-zinc-200" style="font-family:system-ui">ₕₑₗₗₒ ᴡₒᵣₗₖ</div>
    </div>

    <div class="mt-14 space-y-10">
      <div><h2 class="mb-3 text-xl font-semibold text-zinc-900 dark:text-zinc-100">What Is Subscript Text?</h2><div class="space-y-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400"><p>Subscript characters are small letters that sit <strong>below the baseline</strong> of regular text. You see them in chemical formulas (H₂O) and mathematical notation. They are separate Unicode characters, not font formatting.</p><p><strong>Important:</strong> Only 18 of 26 lowercase letters have dedicated subscript characters. Letters without equivalents (b, c, d, f, g, q, w, y, z) remain as regular text. This makes subscript the <strong>least complete</strong> but <strong>most unique</strong> small text style.</p></div></div>

      <div><h2 class="mb-4 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Subscript Character Mapping (18 of 26)</h2><p class="mb-4 text-sm text-zinc-500 dark:text-zinc-400">Green = supported. Amber dash = no Unicode equivalent; stays as regular text.</p><div class="overflow-x-auto rounded-xl border border-zinc-200 dark:border-zinc-800"><table class="w-full text-sm"><thead><tr class="border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/50"><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Letter</th><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Subscript</th><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Letter</th><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Subscript</th></tr></thead><tbody class="text-zinc-600 dark:text-zinc-400"><tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">a</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">ₐ</td><td class="px-4 py-2.5 font-mono text-base">n</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">ₙ</td></tr><tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">b</td><td class="px-4 py-2.5 text-lg text-amber-500 dark:text-amber-400" style="font-family:system-ui">—</td><td class="px-4 py-2.5 font-mono text-base">o</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">ₒ</td></tr><tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">c</td><td class="px-4 py-2.5 text-lg text-amber-500 dark:text-amber-400" style="font-family:system-ui">—</td><td class="px-4 py-2.5 font-mono text-base">p</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">ₚ</td></tr><tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">d</td><td class="px-4 py-2.5 text-lg text-amber-500 dark:text-amber-400" style="font-family:system-ui">—</td><td class="px-4 py-2.5 font-mono text-base">q</td><td class="px-4 py-2.5 text-lg text-amber-500 dark:text-amber-400" style="font-family:system-ui">—</td></tr><tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">e</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">ₑ</td><td class="px-4 py-2.5 font-mono text-base">r</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">ᵣ</td></tr><tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">f</td><td class="px-4 py-2.5 text-lg text-amber-500 dark:text-amber-400" style="font-family:system-ui">—</td><td class="px-4 py-2.5 font-mono text-base">s</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">ₛ</td></tr><tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">g</td><td class="px-4 py-2.5 text-lg text-amber-500 dark:text-amber-400" style="font-family:system-ui">—</td><td class="px-4 py-2.5 font-mono text-base">t</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">ₜ</td></tr><tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">h</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">ₕ</td><td class="px-4 py-2.5 font-mono text-base">u</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">ᵤ</td></tr><tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">i</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">ᵢ</td><td class="px-4 py-2.5 font-mono text-base">v</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">ᵥ</td></tr><tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">j</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">ⱼ</td><td class="px-4 py-2.5 font-mono text-base">w</td><td class="px-4 py-2.5 text-lg text-amber-500 dark:text-amber-400" style="font-family:system-ui">—</td></tr><tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">k</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">ₖ</td><td class="px-4 py-2.5 font-mono text-base">x</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">ₓ</td></tr><tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-mono text-base">l</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">ₗ</td><td class="px-4 py-2.5 font-mono text-base">y</td><td class="px-4 py-2.5 text-lg text-amber-500 dark:text-amber-400" style="font-family:system-ui">—</td></tr><tr class=""><td class="px-4 py-2.5 font-mono text-base">m</td><td class="px-4 py-2.5 text-lg text-accent-600 font-medium" style="font-family:system-ui">ₘ</td><td class="px-4 py-2.5 font-mono text-base">z</td><td class="px-4 py-2.5 text-lg text-amber-500 dark:text-amber-400" style="font-family:system-ui">—</td></tr></tbody></table></div></div>

      <div><h2 class="mb-3 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Platform Compatibility</h2><div class="overflow-x-auto rounded-xl border border-zinc-200 dark:border-zinc-800"><table class="w-full text-sm"><thead><tr class="border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/50"><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Platform</th><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Status</th><th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300">Notes</th></tr></thead><tbody><tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-3 font-medium text-zinc-700 dark:text-zinc-300">Instagram</td><td class="px-4 py-3">Partial</td><td class="px-4 py-3">Supported letters render. Gaps show normally.</td></tr><tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-3 font-medium text-zinc-700 dark:text-zinc-300">Discord</td><td class="px-4 py-3">Limited</td><td class="px-4 py-3">Fewer letters render. Superscript is safer.</td></tr><tr><td class="px-4 py-3 font-medium text-zinc-700 dark:text-zinc-300">Gaming</td><td class="px-4 py-3">Limited</td><td class="px-4 py-3">Not recommended. Use superscript.</td></tr></tbody></table></div></div>

      <!-- Where Subscript Excels -->
      <div>
        <h2 class="mb-3 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Where Subscript Text Is Uniquely Useful</h2>
        <div class="space-y-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
          <div>
            <h3 class="text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5">Chemistry &amp; Science Notation</h3>
            <p>Subscript numbers are essential for chemical formulas: H&#x2082;O (water), CO&#x2082; (carbon dioxide), NaCl, H&#x2082;SO&#x2084;. Our subscript style is fully compatible with subscript numbers via the Tiny Numbers tool — combine them for complete scientific notation in social media posts, study notes, and educational content.</p>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5">Aesthetic Contrast Effect</h3>
            <p>Because subscript text sits below the baseline, it creates a unique layered visual effect when used in bios and display names. A line like "&#x2090;&#x1D62;&#x2099;&#x2099;&#x2092;&#x1D63; &#x2092;&#x1DA0; &#x1D62;&#x209A;" (winner of it) has a distinctive "dropped" look that no other small text style replicates. It draws the eye downward, creating an intentional design rhythm.</p>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5">Short Gaming Tags</h3>
            <p>For short gaming nicknames using only supported letters, subscript creates a unique identity. Games like Minecraft Java Edition and Valorant display subscript characters well. Short tags like "&#x2090;&#x1D62;x" (aix) or "&#x2090;&#x2099;&#x1D63;" (anr) work when the letters are in the supported set.</p>
          </div>
        </div>
      </div>

      <div>
        <h2 class="mb-4 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Frequently Asked Questions</h2>
        <div class="space-y-2">
          <details class="group rounded-xl border border-zinc-200 dark:border-zinc-800">
            <summary class="cursor-pointer px-5 py-4 font-medium text-zinc-800 dark:text-zinc-200 text-sm">Why is subscript the least complete small text style?</summary>
            <div class="px-5 pb-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">The Unicode Consortium designed subscript characters for phonetics and mathematics, not general text styling. Only 18 lowercase letters were assigned code points. No amount of tooling can add more until Unicode itself expands the subscript block — this is the same limitation every small text generator faces.</div>
          </details>
          <details class="group rounded-xl border border-zinc-200 dark:border-zinc-800">
            <summary class="cursor-pointer px-5 py-4 font-medium text-zinc-800 dark:text-zinc-200 text-sm">Is subscript still worth using if letters are missing?</summary>
            <div class="px-5 pb-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">Yes, for short text using mostly supported letters (especially vowels a, e, i, o, u and consonants h, k, l, m, n, p, r, s, t, v, x), subscript creates a distinctive look that no other style replicates. Always test your text before using it publicly — unsupported letters remain as regular text, which can break the visual flow.</div>
          </details>
          <details class="group rounded-xl border border-zinc-200 dark:border-zinc-800">
            <summary class="cursor-pointer px-5 py-4 font-medium text-zinc-800 dark:text-zinc-200 text-sm">Can I use subscript for chemistry and science formulas?</summary>
            <div class="px-5 pb-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">Yes! Subscript numbers are fully supported for formulas like H&#x2082;O, CO&#x2082;, H&#x2082;SO&#x2084;. Our <a href="/tiny-numbers" class="text-accent-600 hover:underline">Tiny Numbers tool</a> handles the number conversion for both superscript and subscript formats. Combine subscript letters with subscript numbers for complete chemical notation.</div>
          </details>
          <details class="group rounded-xl border border-zinc-200 dark:border-zinc-800">
            <summary class="cursor-pointer px-5 py-4 font-medium text-zinc-800 dark:text-zinc-200 text-sm">Which letters are supported in subscript?</summary>
            <div class="px-5 pb-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">18 of 26 letters are supported: a, e, h, i, j, k, l, m, n, o, p, r, s, t, u, v, x. Missing: b, c, d, f, g, q, w, y, z. When typing a word containing unsupported letters, those letters stay as regular text. Check the mapping table above before committing to subscript for important text.</div>
          </details>
          <details class="group rounded-xl border border-zinc-200 dark:border-zinc-800">
            <summary class="cursor-pointer px-5 py-4 font-medium text-zinc-800 dark:text-zinc-200 text-sm">Does subscript work on all platforms?</summary>
            <div class="px-5 pb-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">Subscript has the most limited platform support of any small text style. It works partially on Instagram (supported letters render, gaps show as regular text) and is limited on Discord and gaming platforms. For reliable cross-platform use, superscript is the safer choice. Subscript is best for platform-specific, tested use cases.</div>
          </details>
        </div>
      </div>


      <!-- Related Guides -->
      <div class="rounded-xl border border-accent-200 bg-accent-50/30 p-5 dark:border-accent-900/30 dark:bg-accent-950/10">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-sm">📖</span>
          <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Related Guide</h3>
        </div>
        <a href="/blog/small-text-for-discord" class="text-sm font-medium text-accent-600 hover:text-accent-700 dark:text-accent-400 dark:hover:text-accent-300 hover:underline">Small Text on Discord</a>
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">Which styles render on Discord messages, nicknames, and custom status &mdash; tested on desktop and mobile.</p>
      </div>

      <div class="rounded-xl border border-zinc-200 p-5 dark:border-zinc-800"><h3 class="mb-3 text-sm font-semibold text-zinc-900 dark:text-zinc-100">Try Other Styles</h3><div class="flex flex-wrap gap-2"><a href="/small-caps-text" class="rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-medium text-zinc-600 hover:border-accent-300 hover:text-accent-600 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400">Small Caps</a><a href="/superscript-text" class="rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-medium text-zinc-600 hover:border-accent-300 hover:text-accent-600 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400">Superscript</a><a href="/tiny-numbers" class="rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-medium text-zinc-600 hover:border-accent-300 hover:text-accent-600 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-accent-600 dark:hover:text-accent-400">Tiny Numbers</a><a href="/" class="rounded-lg bg-accent-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-accent-700">Full Generator →</a></div></div>
    </div>
  </main>
</Layout>

<script is:inline>
(function(){var SB={"a":"ₐ","e":"ₑ","h":"ₕ","i":"ᵢ","j":"ⱼ","k":"ₖ","l":"ₗ","m":"ₘ","n":"ₙ","o":"ₒ","p":"ₚ","r":"ᵣ","s":"ₛ","t":"ₜ","u":"ᵤ","v":"ᵥ","x":"ₓ"};var inp=document.getElementById("input"),out=document.getElementById("output"),cp=document.getElementById("copy-btn"),ok=document.getElementById("copied"),t;inp.addEventListener("input",function(){clearTimeout(t);t=setTimeout(function(){var v=inp.value||"hello world",r="";for(var i=0;i<v.length;i++)r+=SB[v[i].toLowerCase()]||v[i];out.textContent=r},50)});cp.addEventListener("click",function(){if(out.textContent){navigator.clipboard.writeText(out.textContent);cp.classList.add("hidden");ok.classList.remove("hidden");setTimeout(function(){ok.classList.add("hidden");cp.classList.remove("hidden")},1500)}});})();
</script>
